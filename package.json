{
  "name": "fogos-launcher",
  "version": "1.1.0",
  "description": "Fogos Launcher",
  "author": "Fogos Launcher Team",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "prestart": "node scripts/patch-electron.js",
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "postinstall": "node scripts/patch-electron.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "marked": "^12.0.0",
    "msmc": "^5.0.5",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "rcedit": "^4.0.1"
  },
  "build": {
    "appId": "com.fogos.launcher",
    "copyright": "Copyright © Fogos Launcher Team",
    "productName": "Fogos Launcher",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "afterPack": "build/afterPack.js",
    "win": {
      "forceCodeSigning": false,
      "signAndEditExecutable": false,
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fogos Launcher",
      "artifactName": "Fogos-Launcher-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Fogos-Launcher-Portable-${version}.${ext}"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.games",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "artifactName": "Fogos-Launcher-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icons",
      "category": "Game",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "Fogos-Launcher-${version}.${ext}"
    }
  }
}